# open.blog's public site and its hosted functions in one container, for a site that leaves Netlify:
# the pages are built here with the engine, then served by the service next to /api/ (service/site.mjs).
# Build from the repository root:
#
#   docker build -f service/Dockerfile.site -t openblog-site .
#
# Needs what service/Dockerfile needs, and OPENBLOG_ADMIN_URL (the editor's https://…/admin/) for the
# /admin forward. The pages are as of the build: a post with a future date appears at the next build,
# so something must rebuild the service hourly (docs/deploy.md "Railway" says how).

FROM rust:1-slim-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p openblog-cli --locked \
    && rm -rf dist && ./target/release/openblog build

FROM node:22-bookworm-slim
ARG POSTGREST_VERSION=12.2.3
ARG POSTGREST_SHA256=9f71269e61ac3a940281e93ff415760f5957e430e475ba4c3889f3ede7d5527c
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client ca-certificates curl xz-utils \
    && curl -fsSL -o /tmp/postgrest.tar.xz \
       "https://github.com/PostgREST/postgrest/releases/download/v${POSTGREST_VERSION}/postgrest-v${POSTGREST_VERSION}-linux-static-x64.tar.xz" \
    && echo "${POSTGREST_SHA256}  /tmp/postgrest.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/postgrest.tar.xz -C /usr/local/bin postgrest \
    && rm /tmp/postgrest.tar.xz \
    && apt-get purge -y xz-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY netlify ./netlify
RUN npm ci --prefix netlify --omit=dev --no-audit --no-fund && npm cache clean --force
COPY supabase ./supabase
COPY service ./service
COPY web/components ./web/components
COPY --from=build /src/dist ./site
RUN chmod +x service/entrypoint.sh service/migrate.sh && postgrest --version
USER node
ENV PORT=8080 NODE_ENV=production OPENBLOG_SITE_DIR=/app/site
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD curl -fsS "http://127.0.0.1:${PORT}/health" > /dev/null || exit 1
ENTRYPOINT ["/app/service/entrypoint.sh"]
