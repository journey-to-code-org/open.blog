    ("*", "quote/*"),
    ("*", "gifts/*"),
    ("*", "push/*"),
    ("*", "greetings/*"),
    ("*", "social/*"),
    ("DELETE", "theme-draft/*"),
    ("*", "voice/samples/*"),
