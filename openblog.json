{
  "title": "open.blog",
  "description": "A blog built with open.blog: Markdown files in, a fast static site out.",
  "url": "https://example.com",
  "language": "en",
  "author": {
    "name": "Your Name",
    "url": "https://example.com",
    "email": ""
  },
  "logo": "",
  "favicon": "",
  "ogImage": "",
  "theme": "base",
  "postPath": "/posts/{slug}/",
  "postsPerPage": 10,
  "nav": [
    { "label": "Home", "href": "/" },
    { "label": "Series", "href": "/series/" },
    { "label": "Archive", "href": "/archive/" },
    { "label": "Search", "href": "/search/" }
  ],
  "social": [],
  "footer": "© {year} {author}",
  "poweredBy": true,
  "share": {
    "enabled": true,
    "networks": ["x", "bluesky", "linkedin", "reddit", "hackernews", "email"]
  },
  "analytics": {
    "builtin": true,
    "showViews": true,
    "retentionDays": 400
  },
  "snippets": {
    "head": "",
    "postFooter": "",
    "bodyEnd": ""
  },
  "relatedPosts": 3,
  "cdn": {
    "url": "",
    "paths": ["/assets/", "/themes/", "/images/"],
    "version": "",
    "maxAge": 86400
  },
  "home": {
    "heading": "Latest posts",
    "intro": "",
    "showSeries": true
  },
  "feeds": {
    "rss": true,
    "json": true,
    "sitemap": true,
    "portfolioSnapshot": true,
    "limit": 20,
    "fullContent": true
  },
  "markdown": {
    "smartPunctuation": false,
    "headingAnchors": true,
    "tocDepth": 3,
    "tocMinHeadings": 3
  },
  "paths": {
    "content": "content",
    "static": "static",
    "output": "dist",
    "themes": "themes",
    "web": "web"
  },
  "admin": {
    "usersFile": ".openblog/users.json",
    "sessionHours": 12,
    "secureCookies": false,
    "maxUploadMb": 10,
    "trustedProxies": []
  }
}
